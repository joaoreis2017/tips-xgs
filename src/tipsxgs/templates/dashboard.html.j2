<!doctype html>
<html lang="pt-PT">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Tips xGScore + Betclic — {{ date_str }}</title>
<style>
  :root{
    --bg:#f7f7f8; --panel:#ffffff; --border:#e3e3e6; --text:#1b1c1f; --muted:#6b6f76;
    --accent:#2f6fed; --good:#12805c; --good-bg:#e6f6ef; --bad:#b3261e;
    --chip-bg:#eef1f6; --shadow:0 1px 2px rgba(0,0,0,.04), 0 1px 8px rgba(0,0,0,.04);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#15161a; --panel:#1e2025; --border:#2c2e34; --text:#eef0f3; --muted:#9a9ea7;
      --accent:#6ea1ff; --good:#3fd68f; --good-bg:#123527; --bad:#ff6b64;
      --chip-bg:#26282e; --shadow:0 1px 2px rgba(0,0,0,.3), 0 1px 10px rgba(0,0,0,.25);
    }
  }
  :root[data-theme="dark"]{
    --bg:#15161a; --panel:#1e2025; --border:#2c2e34; --text:#eef0f3; --muted:#9a9ea7;
    --accent:#6ea1ff; --good:#3fd68f; --good-bg:#123527; --bad:#ff6b64;
    --chip-bg:#26282e; --shadow:0 1px 2px rgba(0,0,0,.3), 0 1px 10px rgba(0,0,0,.25);
  }
  *{box-sizing:border-box;}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    padding:20px 16px 64px; max-width:1080px; margin-inline:auto;
  }
  h1{font-size:1.4rem; margin:0 0 2px;}
  .subtitle{color:var(--muted); font-size:.85rem; margin:0 0 22px;}
  .panel{
    background:var(--panel); border:1px solid var(--border); border-radius:14px;
    box-shadow:var(--shadow); padding:18px; margin-bottom:20px;
  }
  .panel h2{margin:0 0 12px; font-size:1.05rem;}
  table{width:100%; border-collapse:collapse; font-size:.88rem;}
  th{text-align:left; color:var(--muted); font-weight:600; font-size:.72rem; text-transform:uppercase; letter-spacing:.03em; padding:6px 8px; border-bottom:1px solid var(--border);}
  td{padding:8px 8px; border-bottom:1px solid var(--border); vertical-align:middle;}
  tr:last-child td{border-bottom:none;}
  .num{text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap;}
  .pill{display:inline-block; padding:2px 9px; border-radius:999px; font-size:.72rem; font-weight:600; background:var(--chip-bg); color:var(--muted);}
  .value-pill{background:var(--good-bg); color:var(--good);}
  .game-header{display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap; cursor:pointer;}
  .game-header .teams{font-weight:600; font-size:1rem;}
  .game-meta{color:var(--muted); font-size:.8rem;}
  details{background:var(--panel); border:1px solid var(--border); border-radius:14px; box-shadow:var(--shadow); margin-bottom:14px; overflow:hidden;}
  details > summary{list-style:none; padding:14px 18px; cursor:pointer;}
  details > summary::-webkit-details-marker{display:none;}
  details[open] > summary{border-bottom:1px solid var(--border);}
  .details-body{padding:6px 18px 18px;}
  .section-title{font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; color:var(--muted); font-weight:700; margin:16px 0 8px;}
  .empty{color:var(--muted); font-size:.85rem; padding:8px 0;}
  .confidence-low{color:var(--bad);}
  a{color:var(--accent); text-decoration:none;}
  a:hover{text-decoration:underline;}
  .top-row{display:flex; justify-content:space-between; gap:10px;}
  .rank{color:var(--muted); width:1.6em; display:inline-block;}
  @media (max-width:560px){
    .panel, details{border-radius:10px;}
    th,td{padding:6px 4px; font-size:.8rem;}
  }
</style>
</head>
<body>

<h1>⚽ Tips do dia — xGScore × Betclic</h1>
<p class="subtitle">{{ date_str }} · gerado em {{ generated_at }} · {{ games|length }} jogo(s){% if demo %} · <strong>DADOS DE DEMONSTRAÇÃO</strong> (ver README){% endif %}</p>

<div class="panel">
  <h2>🔥 Melhores apostas de valor do dia</h2>
  {% if top_value_bets %}
  <table>
    <thead><tr>
      <th>Jogo</th><th>Mercado</th><th class="num">Prob.</th><th class="num">Odd</th><th class="num">Valor</th>
    </tr></thead>
    <tbody>
    {% for row in top_value_bets %}
      <tr>
        <td><a href="#game-{{ row.game_slug }}">{{ row.game_label }}</a></td>
        <td>{{ row.label }}</td>
        <td class="num">{{ "%.0f"|format(row.probability * 100) }}%</td>
        <td class="num">{{ "%.2f"|format(row.odd) }}</td>
        <td class="num"><span class="pill value-pill">{{ "%.2f"|format(row.value_ratio) }}×</span></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">Sem apostas de valor identificadas (ou faltam odds/previsões calibradas — ver docs/CALIBRATION.md).</p>
  {% endif %}
</div>

{% macro probability_band_panel(icon, title, subtitle, rows, empty_message) %}
<div class="panel">
  <h2>{{ icon }} {{ title }}</h2>
  <p class="subtitle" style="margin:-6px 0 12px;">{{ subtitle }}</p>
  {% if rows %}
  <table>
    <thead><tr>
      <th>Jogo</th><th>Mercado</th><th class="num">Prob.</th><th class="num">Odd</th><th class="num">Valor</th>
    </tr></thead>
    <tbody>
    {% for row in rows %}
      <tr>
        <td><a href="#game-{{ row.game_slug }}">{{ row.game_label }}</a></td>
        <td>{{ row.label }}</td>
        <td class="num">{{ "%.0f"|format(row.probability * 100) }}%</td>
        <td class="num">{{ "%.2f"|format(row.odd) if row.odd else "—" }}</td>
        <td class="num">
          {% if row.value_ratio %}
            <span class="pill {{ 'value-pill' if row.value_ratio > 1.0 else '' }}">{{ "%.2f"|format(row.value_ratio) }}×</span>
          {% else %}—{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p class="empty">{{ empty_message }}</p>
  {% endif %}
</div>
{% endmacro %}

{{ probability_band_panel(
  "🎯",
  "Alta probabilidade (≥" ~ "%.0f"|format(high_probability_min * 100) ~ "%)",
  "Só jogadas com odd Betclic entre " ~ "%.2f"|format(high_odd_min) ~ " e " ~ "%.2f"|format(high_odd_max) ~ " (exclusive) — sem odd nesse intervalo, não aparece aqui.",
  high_probability_bets,
  "Sem acontecimentos nesta banda de probabilidade com odd entre " ~ "%.2f"|format(high_odd_min) ~ " e " ~ "%.2f"|format(high_odd_max) ~ " (ver docs/CALIBRATION.md)."
) }}

{{ probability_band_panel(
  "📊",
  "Probabilidade média (" ~ "%.0f"|format(mid_probability_min * 100) ~ "%–" ~ "%.0f"|format(mid_probability_max * 100) ~ "%)",
  "Todos os jogos com previsão, mesmo sem odds Betclic emparelhadas — odd/valor aparecem a \"—\" quando o jogo ainda não tem odd Betclic emparelhada. Só mercados que a Betclic realmente oferece (1X2, dupla hipótese, ambas marcam, over/under, handicap, totais por equipa) entram aqui.",
  mid_probability_bets,
  "Sem acontecimentos nesta banda de probabilidade (ver docs/CALIBRATION.md)."
) }}

{% for game in games %}
<details id="game-{{ game.slug }}" {% if loop.index <= 3 %}open{% endif %}>
  <summary>
    <div class="game-header">
      <span class="teams">{{ game.home_team }} — {{ game.away_team }}</span>
      <span class="game-meta">
        {{ game.league }}{% if game.kickoff %} · {{ game.kickoff }}{% endif %}
        {% if game.match_confidence is not none %}
          · odds Betclic <span class="{{ 'confidence-low' if game.match_confidence < 90 else '' }}">({{ "%.0f"|format(game.match_confidence) }}% confiança no emparelhamento)</span>
        {% else %}
          · <span class="confidence-low">sem odds Betclic emparelhadas</span>
        {% endif %}
      </span>
    </div>
  </summary>
  <div class="details-body">

    <div class="section-title">Acontecimentos por probabilidade (maior → menor)</div>
    {% if game.events %}
    <table>
      <thead><tr>
        <th>#</th><th>Acontecimento</th><th class="num">Prob. modelo</th><th class="num">Odd Betclic</th><th class="num">Prob. implícita</th><th class="num">Valor</th>
      </tr></thead>
      <tbody>
      {% for e in game.events %}
        <tr>
          <td class="rank">{{ e.rank_by_probability }}</td>
          <td>{{ e.label }}</td>
          <td class="num">{{ "%.0f"|format(e.probability * 100) }}%</td>
          <td class="num">{{ "%.2f"|format(e.odd) if e.odd else "—" }}</td>
          <td class="num">{{ "%.0f"|format(e.implied_probability * 100) + "%" if e.implied_probability else "—" }}</td>
          <td class="num">
            {% if e.value_ratio %}
              <span class="pill {{ 'value-pill' if e.is_value_bet else '' }}">{{ "%.2f"|format(e.value_ratio) }}×</span>
            {% else %}—{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% elif not game.has_predictions %}
    <p class="empty">Sem previsões extraídas para este jogo (ver docs/CALIBRATION.md).</p>
    {% else %}
    <p class="empty">Há previsões do xGScore para este jogo, mas nenhum acontecimento passa do limite de probabilidade configurado (&gt; {{ "%.0f"|format(min_probability * 100) }}%) com uma odd Betclic emparelhada.</p>
    {% endif %}

    <div class="section-title">Melhores apostas de valor deste jogo</div>
    {% if game.value_bets %}
    <table>
      <thead><tr><th>Mercado</th><th class="num">Prob.</th><th class="num">Odd</th><th class="num">Valor</th></tr></thead>
      <tbody>
      {% for v in game.value_bets %}
        <tr>
          <td>{{ v.label }}</td>
          <td class="num">{{ "%.0f"|format(v.probability * 100) }}%</td>
          <td class="num">{{ "%.2f"|format(v.odd) }}</td>
          <td class="num"><span class="pill value-pill">{{ "%.2f"|format(v.value_ratio) }}×</span></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="empty">Nenhuma aposta com valor positivo (valor &gt; 1.00×) encontrada para este jogo.</p>
    {% endif %}

    <p class="game-meta" style="margin-top:14px;"><a href="{{ game.preview_url }}" target="_blank" rel="noopener">Ver análise completa no xGScore →</a></p>
  </div>
</details>
{% else %}
<div class="panel"><p class="empty">Sem jogos para hoje (ou a extração ainda não está calibrada — ver docs/CALIBRATION.md).</p></div>
{% endfor %}

<p class="game-meta">Valor = probabilidade do modelo × odd da Betclic. 1.00× é o ponto de equilíbrio; acima disso, a aposta tem valor esperado positivo segundo o modelo (ex.: prob. 70% e odd 2.00 → 1.40×).</p>

</body>
</html>
